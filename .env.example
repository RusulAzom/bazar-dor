# Copy this file to .env.local and replace the credentials with your own.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@bazar-dor-db.tlgt8xu.mongodb.net/?appName=bazar-dor-db

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_BASE_URL=http://localhost:3000

# Optional: social login providers are enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
